{
  "name": "@soulkit/soul",
  "version": "0.1.0",
  "description": "Soul Core command wrappers for project cognitive continuity.",
  "license": "Apache-2.0",
  "private": false,
  "type": "commonjs",
  "bin": {
    "soul": "bin/soul.js",
    "soul-api": "bin/soul-api.js",
    "soul-mcp": "bin/soul-mcp.js"
  },
  "files": [
    "bin/",
    ".trae/.mcp.json",
    ".trae/hooks.json",
    ".trae/hooks/*.py",
    "docs/",
    "soul/**/*.py",
    "soul/**/*.ts",
    "soul/policies/",
    "soul/schemas/",
    "README.md",
    "pyproject.toml"
  ],
  "scripts": {
    "smoke": "node bin/soul.js --help && node bin/soul-api.js --help && node bin/soul-mcp.js --help",
    "typecheck": "npx pyright"
  },
  "engines": {
    "node": ">=18"
  }
}
