{
  "name": "@soulkit/soul",
  "version": "0.1.0",
  "description": "Soul Core command wrappers for project cognitive continuity.",
  "license": "Apache-2.0",
  "private": false,
  "type": "commonjs",
  "exports": {
    "./dsh": "./soul/adapters/dsh_plugin.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "soul": "bin/soul.js",
    "soul-api": "bin/soul-api.js",
    "soul-mcp": "bin/soul-mcp.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "bin/",
    "cordis.patch.yml",
    ".trae/.mcp.json",
    ".trae/hooks.json",
    ".trae/hooks/*.py",
    "docs/",
    "soul/**/*.py",
    "soul/**/*.ts",
    "soul/**/*.mjs",
    "soul/policies/",
    "soul/schemas/",
    "soul/templates/**/*.html",
    "soul/templates/**/*.swift",
    "soul/templates/**/*.env",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "README.md",
    "pyproject.toml"
  ],
  "scripts": {
    "smoke": "node bin/soul.js --help && node bin/soul-api.js --help && node bin/soul-mcp.js --help",
    "typecheck": "npx pyright"
  },
  "engines": {
    "node": ">=22"
  }
}
